{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/vendorlocation",
      "destination": "/vendorlocation/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron-source-refresh",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/cron-source-refresh.js": {
      "maxDuration": 300
    }
  }
}
